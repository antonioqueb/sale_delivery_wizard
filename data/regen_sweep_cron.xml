<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Barrido de pickings de regeneración duplicados: deduplica y ajusta
         al déficit real. Corre como CRON (registro completo cargado: la
         estrategia de remoción whole_lot_partial vive en un módulo que se
         carga DESPUÉS de este, así que no puede correr en la migración). -->
    <record id="cron_som_regen_sweep" model="ir.cron">
        <field name="name">Entregas: barrido de regeneración pendiente duplicada</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._som_sweep_regen_pickings()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
