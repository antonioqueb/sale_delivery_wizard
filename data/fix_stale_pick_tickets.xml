<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reparación retroactiva de deadlocks de Pick Ticket fantasma
         (corre en cada -u, idempotente vía x_pt_consumed): las remisiones
         confirmadas descuentan sus cantidades de los PTs abiertos de su
         orden; los PTs vaciados se cierran y liberan sus lotes. -->
    <function model="sale.delivery.document" name="_som_fix_consume_stale_pick_tickets"/>
</odoo>
