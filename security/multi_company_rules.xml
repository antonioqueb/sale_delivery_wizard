<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multiempresa: cada documento de entrega vive en la compañía de
             su orden de venta; las líneas y puntos GPS heredan la del
             documento. -->
        <record id="rule_sale_delivery_document_company" model="ir.rule">
            <field name="name">Documento de entrega: multiempresa</field>
            <field name="model_id" ref="model_sale_delivery_document"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_sale_delivery_document_line_company" model="ir.rule">
            <field name="name">Línea de documento de entrega: multiempresa</field>
            <field name="model_id" ref="model_sale_delivery_document_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_sale_delivery_route_point_company" model="ir.rule">
            <field name="name">Punto GPS de entrega: multiempresa</field>
            <field name="model_id" ref="model_sale_delivery_route_point"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
