<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mapa de entregas: solo el mapa, a pantalla completa, en vivo.
         Sin header, sin título, sin botón de actualizar: el JS embebido
         en map_html se refresca solo por polling. -->
    <record id="view_delivery_live_map_form" model="ir.ui.view">
        <field name="name">sale.delivery.live.map.form</field>
        <field name="model">sale.delivery.live.map</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <field name="map_html" widget="html" readonly="1" nolabel="1"
                       options="{'style-inline': true}"/>
            </form>
        </field>
    </record>

    <record id="action_delivery_live_map" model="ir.actions.act_window">
        <field name="name">Mapa en Vivo</field>
        <field name="res_model">sale.delivery.live.map</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_map_mode': 'live'}</field>
    </record>

    <!-- Rutas: histórico de TODAS las rutas registradas, mismo mapa -->
    <record id="action_delivery_route_history" model="ir.actions.act_window">
        <field name="name">Rutas</field>
        <field name="res_model">sale.delivery.live.map</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_map_mode': 'history'}</field>
    </record>

    <!-- Puntos GPS crudos (para auditoría/análisis) -->
    <record id="view_delivery_route_point_list" model="ir.ui.view">
        <field name="name">sale.delivery.route.point.list</field>
        <field name="model">sale.delivery.route.point</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="timestamp"/>
                <field name="document_id"/>
                <field name="user_id"/>
                <field name="event_type"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="speed"/>
            </list>
        </field>
    </record>

    <record id="action_delivery_route_points" model="ir.actions.act_window">
        <field name="name">Puntos de Ruta</field>
        <field name="res_model">sale.delivery.route.point</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_delivery_live_root" name="Entregas"
              web_icon="sale_delivery_wizard,static/description/icon.png"
              sequence="34" groups="sale_delivery_wizard.group_delivery_user"/>
    <menuitem id="menu_delivery_live_map" name="Mapa en Vivo"
              parent="menu_delivery_live_root"
              action="action_delivery_live_map" sequence="1"/>
    <menuitem id="menu_delivery_route_history" name="Rutas"
              parent="menu_delivery_live_root"
              action="action_delivery_route_history" sequence="2"/>
    <menuitem id="menu_delivery_route_points" name="Puntos de Ruta"
              parent="menu_delivery_live_root"
              action="action_delivery_route_points" sequence="3"
              groups="sale_delivery_wizard.group_delivery_manager"/>
</odoo>
