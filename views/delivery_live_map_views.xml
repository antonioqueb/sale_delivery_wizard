<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mapa de entregas: client action OWL (delivery_live_map.js) con
         Leaflet vendorizado. Siempre muestra el mapa (Monterrey, MX) aunque
         no haya choferes activos; los datos llegan por polling, sin botón
         de actualizar, sin títulos y sin HTML embebido. -->
    <record id="action_delivery_live_map_client" model="ir.actions.client">
        <field name="name">Mapa en Vivo</field>
        <field name="tag">sale_delivery_wizard.live_map</field>
        <field name="params" eval="{'mode': 'live'}"/>
    </record>

    <record id="action_delivery_route_history_client" model="ir.actions.client">
        <field name="name">Rutas</field>
        <field name="tag">sale_delivery_wizard.live_map</field>
        <field name="params" eval="{'mode': 'history'}"/>
    </record>

    <!-- Reportería: dashboard operativo con KPIs, gráficas y detalle por
         vehículo (capacidad m² / odómetro de flota) y por chofer. -->
    <record id="action_delivery_report_dashboard" model="ir.actions.client">
        <field name="name">Reportería</field>
        <field name="tag">sale_delivery_wizard.report_dashboard</field>
    </record>

    <!-- Puntos GPS crudos (para auditoría/análisis) -->
    <record id="view_delivery_route_point_list" model="ir.ui.view">
        <field name="name">sale.delivery.route.point.list</field>
        <field name="model">sale.delivery.route.point</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="timestamp"/>
                <field name="document_id"/>
                <field name="user_id"/>
                <field name="event_type"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="speed"/>
            </list>
        </field>
    </record>

    <record id="action_delivery_route_points" model="ir.actions.act_window">
        <field name="name">Puntos de Ruta</field>
        <field name="res_model">sale.delivery.route.point</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_delivery_live_root" name="Entregas"
              web_icon="sale_delivery_wizard,static/description/icon.png"
              sequence="34" groups="sale_delivery_wizard.group_delivery_user"/>
    <menuitem id="menu_delivery_live_map" name="Mapa en Vivo"
              parent="menu_delivery_live_root"
              action="action_delivery_live_map_client" sequence="1"/>
    <menuitem id="menu_delivery_route_history" name="Rutas"
              parent="menu_delivery_live_root"
              action="action_delivery_route_history_client" sequence="2"/>
    <menuitem id="menu_delivery_report_dashboard" name="Reportería"
              parent="menu_delivery_live_root"
              action="action_delivery_report_dashboard" sequence="3"
              groups="sale_delivery_wizard.group_delivery_manager"/>
    <menuitem id="menu_delivery_route_points" name="Puntos de Ruta"
              parent="menu_delivery_live_root"
              action="action_delivery_route_points" sequence="4"
              groups="sale_delivery_wizard.group_delivery_manager"/>
</odoo>
