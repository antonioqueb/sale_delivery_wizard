<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════ Wizards ═══════════ -->
    <record id="view_sale_delivery_schedule_move_wizard" model="ir.ui.view">
        <field name="name">sale.delivery.schedule.move.wizard.form</field>
        <field name="model">sale.delivery.schedule.move.wizard</field>
        <field name="arch" type="xml">
            <form string="Reprogramar entrega">
                <group>
                    <field name="schedule_id"/>
                    <field name="current_date"/>
                    <field name="new_date"/>
                    <field name="reason" placeholder="Por qué se mueve (lo ve el vendedor y queda en el historial)"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reprogramar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_sale_delivery_schedule_move_wizard" model="ir.actions.act_window">
        <field name="name">Reprogramar entrega</field>
        <field name="res_model">sale.delivery.schedule.move.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_sale_delivery_schedule_cancel_wizard" model="ir.ui.view">
        <field name="name">sale.delivery.schedule.cancel.wizard.form</field>
        <field name="model">sale.delivery.schedule.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancelar programación">
                <group>
                    <field name="schedule_id"/>
                    <field name="reason" placeholder="Motivo de la cancelación"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Cancelar programación" class="btn-danger"/>
                    <button string="Volver" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_sale_delivery_schedule_cancel_wizard" model="ir.actions.act_window">
        <field name="name">Cancelar programación</field>
        <field name="res_model">sale.delivery.schedule.cancel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ═══════════ Logística: asignar unidad (→ Programada) ═══════════ -->
    <record id="view_sale_delivery_schedule_plan_wizard" model="ir.ui.view">
        <field name="name">sale.delivery.schedule.plan.wizard.form</field>
        <field name="model">sale.delivery.schedule.plan.wizard</field>
        <field name="arch" type="xml">
            <form string="Programar entrega">
                <group>
                    <field name="schedule_id"/>
                    <field name="vehicle_id" options="{'no_create': True}"/>
                    <field name="vehicle_driver_id" options="{'no_create': True}"/>
                    <field name="logistics_user_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Programar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_sale_delivery_schedule_plan_wizard" model="ir.actions.act_window">
        <field name="name">Programar entrega</field>
        <field name="res_model">sale.delivery.schedule.plan.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ═══════════ Formulario ═══════════
         Dos dominios (27 sep 2026): la SOLICITUD (qué, cuánto, dónde,
         cuándo, especificaciones) la ven todos; lo de LOGÍSTICA (responsable,
         unidad, chofer, documentos, botones de ejecución) solo el grupo
         Usuario de Entregas. La solicitud nueva se captura en el asistente
         guiado desde la orden, no aquí. -->
    <record id="view_sale_delivery_schedule_form" model="ir.ui.view">
        <field name="name">sale.delivery.schedule.form</field>
        <field name="model">sale.delivery.schedule</field>
        <field name="arch" type="xml">
            <!-- Diseño propio (27 sep 2026): tarjetas con estilos de
                 static/src/scss/schedule_form.scss (clase o_som_request_form),
                 misma paleta del asistente «Solicitar entrega». -->
            <form string="Solicitud de entrega" create="0" class="o_som_request_form">
                <header>
                    <button name="action_confirm" type="object" string="Confirmar solicitud" class="btn-primary"
                            icon="fa-check" invisible="state not in ('scheduled', 'rescheduled')"
                            groups="sale_delivery_wizard.group_delivery_user"/>
                    <button name="%(action_sale_delivery_schedule_plan_wizard)d" type="action" string="Asignar unidad y programar"
                            icon="fa-truck" class="btn-primary"
                            context="{'default_schedule_id': id, 'default_vehicle_id': vehicle_id, 'default_vehicle_driver_id': vehicle_driver_id}"
                            invisible="state not in ('confirmed', 'programmed')" groups="sale_delivery_wizard.group_delivery_user"/>
                    <button name="action_generate_delivery" type="object" string="Continuar a la entrega" icon="fa-arrow-right"
                            invisible="state not in ('confirmed', 'programmed', 'in_progress')"
                            groups="sale_delivery_wizard.group_delivery_user"
                            help="Abre el asistente de entrega de la orden (flujo actual) con la dirección, la unidad y los materiales de esta solicitud."/>
                    <button name="%(action_sale_delivery_schedule_move_wizard)d" type="action" string="Reprogramar" icon="fa-calendar"
                            invisible="state not in ('scheduled', 'confirmed', 'programmed', 'rescheduled', 'in_progress')"
                            context="{'default_schedule_id': id}"/>
                    <button name="%(action_sale_delivery_schedule_cancel_wizard)d" type="action" string="Cancelar solicitud"
                            invisible="state in ('done', 'cancelled')" context="{'default_schedule_id': id}"/>
                    <button name="action_reopen" type="object" string="Reabrir" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,confirmed,programmed,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_order" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_stat_info"><span class="o_stat_text">Orden</span><span class="o_stat_value"><field name="sale_order_id" readonly="1" nolabel="1"/></span></div>
                        </button>
                        <button name="action_open_map" type="object" class="oe_stat_button" icon="fa-map-marker" invisible="not has_location">
                            <div class="o_stat_info"><span class="o_stat_text">Ver en</span><span class="o_stat_value">Google Maps</span></div>
                        </button>
                    </div>

                    <div class="o_sr_root">
                        <field name="commercial_partner_id" invisible="1"/>
                        <field name="longitude" invisible="1"/>
                        <field name="has_location" invisible="1"/>

                        <!-- ═══ Encabezado ═══ -->
                        <div class="o_sr_hero">
                            <div class="o_sr_hero_main">
                                <div class="o_sr_kicker"><i class="fa fa-truck" title="Solicitud de entrega"/> Solicitud de entrega</div>
                                <h1 class="o_sr_title"><field name="name" readonly="1"/></h1>
                                <div class="o_sr_meta">
                                    <span class="o_sr_meta_item"><i class="fa fa-building-o" title="Cliente"/> <field name="partner_id" readonly="1"/></span>
                                    <span class="o_sr_meta_item"><i class="fa fa-user-o" title="Solicitó"/> Solicitó <field name="user_id" readonly="1"/></span>
                                    <span class="o_sr_meta_item" invisible="not logistics_user_id" groups="sale_delivery_wizard.group_delivery_user">
                                        <i class="fa fa-headphones" title="Responsable de logística"/> <field name="logistics_user_id" readonly="1"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_sr_when">
                                <div class="o_sr_when_label">Fecha solicitada</div>
                                <div class="o_sr_when_date"><field name="date" readonly="id" help="Una vez creada, la fecha solo cambia con «Reprogramar» (queda historial)."/></div>
                                <div class="o_sr_when_window">
                                    <field name="time_window" readonly="state not in ('scheduled', 'rescheduled')"/>
                                    <field name="time_exact" widget="float_time" invisible="time_window != 'exact'"
                                           required="time_window == 'exact'" readonly="state not in ('scheduled', 'rescheduled')"/>
                                </div>
                                <div class="o_sr_when_moves" invisible="not reschedule_count">
                                    <i class="fa fa-history" title="Reprogramaciones"/> Reprogramaciones: <field name="reschedule_count" readonly="1"/>
                                </div>
                            </div>
                        </div>

                        <!-- ═══ Avisos ═══ -->
                        <div class="o_sr_notice o_sr_notice_info" invisible="state != 'rescheduled'">
                            <i class="fa fa-calendar" title="Reprogramada"/>
                            <span>La fecha cambió: logística debe volver a confirmar la solicitud.</span>
                        </div>
                        <div class="o_sr_notice o_sr_notice_warn" groups="sale_delivery_wizard.group_delivery_user"
                             invisible="not readiness or state in ('done','cancelled')">
                            <i class="fa fa-exclamation-triangle" title="Pendientes"/>
                            <span><b>Pendientes para logística:</b> <field name="readiness" readonly="1"/></span>
                        </div>
                        <div class="o_sr_notice o_sr_notice_muted" invisible="state != 'cancelled'">
                            <i class="fa fa-ban" title="Cancelada"/>
                            <span><b>Cancelada.</b> <field name="cancel_reason" readonly="1"/></span>
                        </div>

                        <!-- ═══ 1. Materiales ═══ -->
                        <div class="o_sr_card">
                            <div class="o_sr_card_head">
                                <span class="o_sr_num">1</span>
                                <div><div class="o_sr_card_title">Materiales a entregar</div>
                                    <div class="o_sr_card_sub">Lo que se entrega en esta solicitud</div></div>
                            </div>
                            <field name="line_ids" readonly="1" nolabel="1" class="o_sr_lines" invisible="not line_ids">
                                <list>
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="uom_name"/>
                                </list>
                            </field>
                            <div class="o_sr_empty" invisible="line_ids">
                                Solicitud anterior al detalle por material: toda la orden. Pendiente por entregar:
                                <field name="qty_summary" readonly="1"/>
                            </div>
                        </div>

                        <!-- ═══ 2. Dirección y ubicación ═══ -->
                        <div class="o_sr_card">
                            <div class="o_sr_card_head">
                                <span class="o_sr_num">2</span>
                                <div><div class="o_sr_card_title">Dirección y ubicación</div>
                                    <div class="o_sr_card_sub">El mapa valida la dirección; moverlo no cambia el texto</div></div>
                            </div>
                            <div class="o_sr_split">
                                <div class="o_sr_fields">
                                    <div class="o_sr_field">
                                        <label for="partner_shipping_id" string="Dirección del cliente"/>
                                        <field name="partner_shipping_id" options="{'no_create': True, 'no_open': True}"
                                               readonly="state not in ('scheduled', 'rescheduled')"/>
                                    </div>
                                    <div class="o_sr_field_row">
                                        <div class="o_sr_field">
                                            <label for="contact_name" string="Contacto en sitio"/>
                                            <field name="contact_name" readonly="state not in ('scheduled', 'rescheduled')"/>
                                        </div>
                                        <div class="o_sr_field">
                                            <label for="contact_phone" string="Teléfono"/>
                                            <field name="contact_phone" widget="phone" readonly="state not in ('scheduled', 'rescheduled')"/>
                                        </div>
                                    </div>
                                    <div class="o_sr_field">
                                        <label for="delivery_address" string="Dirección de entrega"/>
                                        <field name="delivery_address" readonly="state not in ('scheduled', 'rescheduled')"
                                               help="La dirección capturada no se cambia al mover el punto del mapa: el mapa solo guarda las coordenadas."/>
                                    </div>
                                </div>
                                <div class="o_sr_map">
                                    <field name="latitude" widget="som_map_picker" nolabel="1"
                                           readonly="state not in ('scheduled', 'rescheduled', 'confirmed', 'programmed')"
                                           options="{'lng_field': 'longitude', 'address_field': 'delivery_address'}"/>
                                </div>
                            </div>
                        </div>

                        <div class="o_sr_pair">
                            <!-- ═══ 3. Condiciones ═══ -->
                            <div class="o_sr_card">
                                <div class="o_sr_card_head">
                                    <span class="o_sr_num">3</span>
                                    <div><div class="o_sr_card_title">Condiciones</div>
                                        <div class="o_sr_card_sub">Pago y autorización de la orden</div></div>
                                </div>
                                <div class="o_sr_facts">
                                    <div class="o_sr_fact">
                                        <span class="k">Pago / autorización</span>
                                        <span class="v"><field name="auth_label" readonly="1"/></span>
                                    </div>
                                    <div class="o_sr_fact">
                                        <span class="k">Fecha original</span>
                                        <span class="v"><field name="original_date" readonly="1"/></span>
                                    </div>
                                    <div class="o_sr_fact" invisible="not delivered_at">
                                        <span class="k">Entregada el</span>
                                        <span class="v"><field name="delivered_at" readonly="1"/></span>
                                    </div>
                                </div>
                            </div>
                            <!-- ═══ 4. Especificaciones ═══ -->
                            <div class="o_sr_card">
                                <div class="o_sr_card_head">
                                    <span class="o_sr_num">4</span>
                                    <div><div class="o_sr_card_title">Especificaciones</div>
                                        <div class="o_sr_card_sub">Lo primero que lee logística</div></div>
                                </div>
                                <field name="instructions" nolabel="1" class="o_sr_specs" readonly="state in ('done', 'cancelled')"
                                       placeholder="Quién recibe, horario del sitio, acceso, maniobra o equipo necesario, piso, restricciones…"/>
                            </div>
                        </div>

                        <!-- ═══ Logística (solo Usuario de Entregas) ═══ -->
                        <div class="o_sr_card o_sr_card_logistics" groups="sale_delivery_wizard.group_delivery_user">
                            <div class="o_sr_card_head">
                                <span class="o_sr_num o_sr_num_log"><i class="fa fa-truck" title="Logística"/></span>
                                <div><div class="o_sr_card_title">Logística</div>
                                    <div class="o_sr_card_sub">Responsable, unidad y documentos del flujo de entrega</div></div>
                            </div>
                            <div class="o_sr_field_row o_sr_field_row_3">
                                <div class="o_sr_field">
                                    <label for="logistics_user_id" string="Responsable"/>
                                    <field name="logistics_user_id" options="{'no_create': True}"/>
                                </div>
                                <div class="o_sr_field">
                                    <label for="vehicle_id" string="Vehículo"/>
                                    <field name="vehicle_id" options="{'no_create': True}"/>
                                </div>
                                <div class="o_sr_field">
                                    <label for="vehicle_driver_id" string="Chofer"/>
                                    <field name="vehicle_driver_id" options="{'no_create': True}"/>
                                </div>
                            </div>
                            <div class="o_sr_docs">
                                <div class="o_sr_doc">
                                    <span class="k"><i class="fa fa-list-alt" title="Pick ticket"/> Pick ticket</span>
                                    <field name="pick_ticket_id" readonly="1"/>
                                </div>
                                <div class="o_sr_doc">
                                    <span class="k"><i class="fa fa-file-text" title="Remisión"/> Remisión</span>
                                    <field name="remission_id" readonly="1"/>
                                </div>
                            </div>
                        </div>

                        <!-- ═══ Historial ═══ -->
                        <div class="o_sr_card" invisible="not move_ids">
                            <div class="o_sr_card_head">
                                <span class="o_sr_num o_sr_num_hist"><i class="fa fa-history" title="Historial"/></span>
                                <div><div class="o_sr_card_title">Historial de cambios</div>
                                    <div class="o_sr_card_sub">Reprogramaciones y cancelaciones: quién, cuándo y por qué</div></div>
                            </div>
                            <field name="move_ids" readonly="1" nolabel="1" class="o_sr_lines">
                                <list>
                                    <field name="create_date" string="Cuándo"/>
                                    <field name="kind"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="source"/>
                                    <field name="user_id"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </div>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════ Bandeja de logística ═══════════ -->
    <record id="view_sale_delivery_schedule_list" model="ir.ui.view">
        <field name="name">sale.delivery.schedule.list</field>
        <field name="model">sale.delivery.schedule</field>
        <field name="arch" type="xml">
            <list create="0" decoration-success="state == 'done'" decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'in_progress'" decoration-warning="state in ('scheduled', 'rescheduled')">
                <field name="name" string="Folio"/>
                <field name="date" string="Fecha solicitada"/>
                <field name="time_window" optional="show"/>
                <field name="partner_id"/>
                <field name="sale_order_id" string="OV"/>
                <field name="material_summary"/>
                <field name="delivery_address" optional="show"/>
                <field name="state" widget="badge"
                       decoration-warning="state in ('scheduled', 'rescheduled')"
                       decoration-info="state in ('confirmed', 'programmed', 'in_progress')"
                       decoration-success="state == 'done'"/>
                <field name="logistics_user_id" string="Responsable" optional="show"/>
                <field name="vehicle_id" optional="show"/>
                <field name="vehicle_driver_id" string="Chofer" optional="show"/>
                <field name="user_id" string="Solicitó" optional="hide"/>
                <field name="reschedule_count" optional="hide"/>
                <field name="readiness" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Lista del solicitante: sin datos de ejecución logística. -->
    <record id="view_sale_delivery_schedule_list_requester" model="ir.ui.view">
        <field name="name">sale.delivery.schedule.list.requester</field>
        <field name="model">sale.delivery.schedule</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list create="0" decoration-success="state == 'done'" decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'in_progress'">
                <field name="name" string="Folio"/>
                <field name="date" string="Fecha solicitada"/>
                <field name="time_window" optional="show"/>
                <field name="sale_order_id" string="OV"/>
                <field name="partner_id"/>
                <field name="material_summary"/>
                <field name="delivery_address" optional="hide"/>
                <field name="reschedule_count" optional="show"/>
                <field name="state" widget="badge"
                       decoration-warning="state in ('scheduled', 'rescheduled')"
                       decoration-info="state in ('confirmed', 'programmed', 'in_progress')"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_sale_delivery_schedule_kanban" model="ir.ui.view">
        <field name="name">sale.delivery.schedule.kanban</field>
        <field name="model">sale.delivery.schedule</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" create="0" group_create="0" group_delete="0" group_edit="0"
                    quick_create="0" records_draggable="0">
                <field name="state"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold"/>
                            <field name="date"/>
                        </div>
                        <field name="partner_id"/>
                        <div class="text-muted small"><field name="sale_order_id"/> · <field name="time_window"/></div>
                        <div class="small mt-1"><field name="material_summary"/></div>
                        <div class="d-flex justify-content-between small text-muted mt-1">
                            <field name="vehicle_id"/>
                            <field name="logistics_user_id" widget="many2one_avatar_user"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sale_delivery_schedule_calendar" model="ir.ui.view">
        <field name="name">sale.delivery.schedule.calendar</field>
        <field name="model">sale.delivery.schedule</field>
        <field name="arch" type="xml">
            <calendar date_start="date" color="user_id" mode="week" quick_create="0" event_open_popup="1" hide_time="1">
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="time_window"/>
                <field name="state"/>
                <field name="material_summary"/>
                <field name="user_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_sale_delivery_schedule_search" model="ir.ui.view">
        <field name="name">sale.delivery.schedule.search</field>
        <field name="model">sale.delivery.schedule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="material_summary"/>
                <field name="vehicle_id"/>
                <filter name="mine" string="Mis solicitudes" domain="[('user_id', '=', uid)]"/>
                <filter name="my_logistics" string="Asignadas a mí" domain="[('logistics_user_id', '=', uid)]"/>
                <separator/>
                <filter name="pending" string="Pendientes de confirmar" domain="[('state', 'in', ('scheduled', 'rescheduled'))]"/>
                <filter name="confirmed" string="Confirmadas" domain="[('state', '=', 'confirmed')]"/>
                <filter name="programmed" string="Programadas" domain="[('state', '=', 'programmed')]"/>
                <filter name="state_rescheduled" string="Reprogramadas" domain="[('state', '=', 'rescheduled')]"/>
                <filter name="in_progress" string="En proceso" domain="[('state', '=', 'in_progress')]"/>
                <filter name="done" string="Entregadas" domain="[('state', '=', 'done')]"/>
                <filter name="cancelled" string="Canceladas" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="open" string="Abiertas" domain="[('state', 'in', ('scheduled', 'confirmed', 'programmed', 'rescheduled', 'in_progress'))]"/>
                <filter name="rescheduled" string="Con reprogramaciones" domain="[('reschedule_count', '>', 0)]"/>
                <filter name="no_location" string="Sin ubicación" domain="[('has_location', '=', False)]"/>
                <separator/>
                <filter name="group_date" string="Fecha" context="{'group_by': 'date'}"/>
                <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                <filter name="group_logistics" string="Responsable" context="{'group_by': 'logistics_user_id'}"/>
                <filter name="group_seller" string="Solicitante" context="{'group_by': 'user_id'}"/>
                <filter name="group_vehicle" string="Vehículo" context="{'group_by': 'vehicle_id'}"/>
            </search>
        </field>
    </record>

    <!-- ═══════════ Acciones ═══════════ -->
    <record id="action_delivery_planner" model="ir.actions.client">
        <field name="name">Planificación</field>
        <field name="tag">sale_delivery_wizard.delivery_planner</field>
    </record>
    <record id="action_delivery_planner_mine" model="ir.actions.client">
        <field name="name">Mis entregas</field>
        <field name="tag">sale_delivery_wizard.delivery_planner</field>
        <field name="params" eval="{'only_mine': True}"/>
    </record>
    <!-- Bandeja de logística: todas las solicitudes, abiertas por defecto. -->
    <record id="action_sale_delivery_schedule" model="ir.actions.act_window">
        <field name="name">Solicitudes de entrega</field>
        <field name="res_model">sale.delivery.schedule</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_sale_delivery_schedule_list')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_sale_delivery_schedule_kanban')}),
            (0, 0, {'view_mode': 'calendar', 'view_id': ref('view_sale_delivery_schedule_calendar')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_sale_delivery_schedule_form')})]"/>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin solicitudes de entrega</p>
            <p>Las solicitudes nacen en la orden de venta con «Solicitar entrega».</p>
        </field>
    </record>
    <record id="action_sale_delivery_schedule_mine" model="ir.actions.act_window">
        <field name="name">Mis solicitudes de entrega</field>
        <field name="res_model">sale.delivery.schedule</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_sale_delivery_schedule_list_requester')}),
            (0, 0, {'view_mode': 'calendar', 'view_id': ref('view_sale_delivery_schedule_calendar')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_sale_delivery_schedule_form')})]"/>
        <field name="context">{'search_default_mine': 1, 'search_default_open': 1}</field>
    </record>
    <record id="action_delivery_request" model="ir.actions.client">
        <field name="name">Solicitar entrega</field>
        <field name="tag">sale_delivery_wizard.delivery_request</field>
    </record>

    <!-- ═══════════ Menús ═══════════ -->
    <!-- Entregas (logística): Planificación es lo PRIMERO que se ve. -->
    <menuitem id="menu_delivery_planner" name="Planificación"
              parent="sale_delivery_wizard.menu_delivery_live_root"
              action="action_delivery_planner" sequence="-10"/>
    <!-- Bandeja de Logística: lo primero que ve Entregas (27 sep 2026). -->
    <menuitem id="menu_delivery_schedule" name="Solicitudes"
              parent="sale_delivery_wizard.menu_delivery_live_root"
              action="action_sale_delivery_schedule" sequence="-20"/>

    <!-- Mis Entregas (vendedores): raíz propia. Logística no la necesita:
         su trabajo vive en Entregas › Planificación. -->
    <menuitem id="menu_my_deliveries_root" name="Mis Entregas"
              web_icon="sale_delivery_wizard,static/description/icon_my_deliveries.svg"
              sequence="35" groups="sales_team.group_sale_salesman"/>
    <menuitem id="menu_my_deliveries_planner" name="Mi semana"
              parent="menu_my_deliveries_root" action="action_delivery_planner_mine" sequence="1"/>
    <menuitem id="menu_my_deliveries_list" name="Mis solicitudes"
              parent="menu_my_deliveries_root" action="action_sale_delivery_schedule_mine" sequence="2"/>

    <!-- ═══════════ Orden de venta: botón y smart button ═══════════ -->
    <record id="view_order_form_delivery_schedule" model="ir.ui.view">
        <field name="name">sale.order.form.delivery.schedule</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">98</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_schedule_delivery"
                        string="Solicitar entrega"
                        type="object"
                        class="btn-primary"
                        icon="fa-calendar"
                        invisible="state not in ('sale', 'done') or not x_can_schedule_delivery"
                        groups="sales_team.group_sale_salesman,sale_delivery_wizard.group_delivery_user"/>
                <field name="x_can_schedule_delivery" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_delivery_schedules" type="object" class="oe_stat_button" icon="fa-calendar"
                        invisible="delivery_schedule_count == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="next_delivery_date" nolabel="1" readonly="1"/></span>
                        <span class="o_stat_text">Entregas solicitadas</span>
                    </div>
                </button>
                <field name="delivery_schedule_count" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
