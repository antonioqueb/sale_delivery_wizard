<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ═══ Íconos SVG hechos a mano (sin emojis) ═══ -->
    <t t-name="sale_delivery_wizard.icon_clipboard">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="4.5" width="14" height="17" rx="2.5"/>
            <path d="M9 4.5V3h6v1.5"/>
            <path d="M8.5 10h7M8.5 13.5h7M8.5 17h4.5"/>
        </svg>
    </t>
    <t t-name="sale_delivery_wizard.icon_scan">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 8V5.5A1.5 1.5 0 0 1 5.5 4H8M16 4h2.5A1.5 1.5 0 0 1 20 5.5V8M20 16v2.5a1.5 1.5 0 0 1-1.5 1.5H16M8 20H5.5A1.5 1.5 0 0 1 4 18.5V16"/>
            <path d="M4 12h16"/>
        </svg>
    </t>
    <t t-name="sale_delivery_wizard.icon_truck">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 6h12v10H2z"/>
            <path d="M14 9h4l3 3.5V16h-7"/>
            <circle cx="6.5" cy="17.8" r="1.9"/>
            <circle cx="17.5" cy="17.8" r="1.9"/>
        </svg>
    </t>
    <t t-name="sale_delivery_wizard.icon_check">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"/>
            <path d="M8 12.5l2.7 2.7L16.5 9"/>
        </svg>
    </t>
    <t t-name="sale_delivery_wizard.icon_sign">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 20c2-.6 3-2 4-4l7.5-11a2 2 0 0 1 3.3 2.2L11 18c-1.4 1.6-3 2.2-7 2z"/>
            <path d="M13 20h7"/>
        </svg>
    </t>
    <t t-name="sale_delivery_wizard.icon_alert2">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3.5L22 20H2L12 3.5z"/>
            <path d="M12 10v4.5"/>
            <circle cx="12" cy="17.2" r="0.4" fill="currentColor"/>
        </svg>
    </t>
    <t t-name="sale_delivery_wizard.icon_open2">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 4h6v6"/>
            <path d="M20 4L11 13"/>
            <path d="M19 14v5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h5"/>
        </svg>
    </t>
    <t t-name="sale_delivery_wizard.icon_area">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="4" width="16" height="16" rx="2"/>
            <path d="M4 12h16M12 4v16"/>
        </svg>
    </t>
    <t t-name="sale_delivery_wizard.icon_search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="6.5"/>
            <path d="M16 16l4.5 4.5"/>
        </svg>
    </t>
    <t t-name="sale_delivery_wizard.icon_map">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2z"/>
            <path d="M9 4v14M15 6v14"/>
        </svg>
    </t>
    <t t-name="sale_delivery_wizard.icon_arrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
    </t>
    <t t-name="sale_delivery_wizard.icon_refresh">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 12a8 8 0 1 1-2.3-5.7"/>
            <path d="M20 4v5h-5"/>
        </svg>
    </t>
    <t t-name="sale_delivery_wizard.icon_stage">
        <t t-if="icon === 'clipboard'"><t t-call="sale_delivery_wizard.icon_clipboard"/></t>
        <t t-elif="icon === 'scan'"><t t-call="sale_delivery_wizard.icon_scan"/></t>
        <t t-elif="icon === 'truck'"><t t-call="sale_delivery_wizard.icon_truck"/></t>
        <t t-else=""><t t-call="sale_delivery_wizard.icon_check"/></t>
    </t>

    <!-- ═══ Tarjeta de documento ═══ -->
    <t t-name="sale_delivery_wizard.OutboundCard">
        <div t-attf-class="o_out_card {{ stageKey }} {{ !card.vehicle and stageKey !== 'delivered' ? 'noveh' : '' }} {{ state.drag and state.drag.id === card.id ? 'dragging' : '' }}"
             t-att-draggable="stageKey !== 'delivered' ? 'true' : 'false'"
             t-on-dragstart="(ev) => this.onDragStart(ev, card, stageKey)"
             t-on-dragend="onDragEnd">
            <div class="o_out_card_top">
                <span class="o_out_card_name" t-esc="card.name"/>
                <span t-if="card.auth_ok" class="o_out_badge green">Autorizada</span>
                <span t-elif="card.auth" class="o_out_badge amber">Por autorizar</span>
                <span t-attf-class="o_out_age {{ this.ageCls(card) }}" t-att-title="'Creado ' + card.created" t-esc="this.ageLabel(card)"/>
            </div>
            <div class="o_out_card_sub">
                <b t-esc="card.partner"/>
                <span t-if="card.order" class="link" t-on-click.stop="() => this.openOrder(card.order_id)">
                    <t t-esc="card.order"/>
                </span>
            </div>
            <div t-if="card.address" class="o_out_addr" t-att-title="card.address" t-esc="card.address"/>
            <div class="o_out_card_stats">
                <span class="qty"><t t-call="sale_delivery_wizard.icon_area"/><b t-esc="card.qty_label"/></span>
                <span><b t-esc="card.lines"/> líneas</span>
                <span t-if="card.pt" class="o_out_pt" t-att-title="'Pick ticket origen'">PT <t t-esc="card.pt"/></span>
            </div>
            <div class="o_out_mats" t-if="card.materials and card.materials.length">
                <div class="m" t-foreach="card.materials.slice(0, 2)" t-as="mt" t-key="mt.product + mt.uom">
                    <span t-att-title="mt.product" t-esc="mt.product"/>
                    <b><t t-esc="mt.qty"/> <t t-esc="mt.uom"/></b>
                </div>
                <div class="more" t-if="card.materials.length > 2">
                    +<t t-esc="card.materials.length - 2"/> materiales más
                </div>
            </div>
            <div t-if="card.note" class="o_out_note" t-att-title="card.note">
                <t t-esc="card.note"/>
            </div>

            <!-- Camión y chofer: se asignan desde la orden de venta al generar la entrega; aquí solo se muestran -->
            <div class="o_out_card_meta">
                <span t-if="card.vehicle" class="o_out_veh done">
                    <t t-call="sale_delivery_wizard.icon_truck"/>
                    <span class="txt"><t t-esc="card.vehicle"/><t t-if="card.driver"> · <t t-esc="card.driver"/></t></span>
                </span>
                <span t-elif="stageKey !== 'delivered'" class="o_out_veh warn" title="Asigna el camión desde la orden de venta al generar la entrega">
                    <t t-call="sale_delivery_wizard.icon_alert2"/>
                    <span class="txt">Sin camión</span>
                </span>
            </div>

            <div t-if="card.signed_at" class="o_out_signed">
                <t t-call="sale_delivery_wizard.icon_sign"/>
                Firmada <t t-esc="card.signed_at"/>
            </div>

            <div class="o_out_card_actions">
                <button class="o_out_btn ghost" t-on-click.stop="() => this.openPdf(card.doc_type, card.id)" title="Ver PDF">
                    PDF <t t-call="sale_delivery_wizard.icon_open2"/>
                </button>
                <button class="o_out_btn ghost" t-on-click.stop="() => this.openDoc(card.id)" title="Abrir el documento">
                    Abrir
                </button>
                <span class="grow"/>
                <button t-if="stageKey === 'pending'" class="o_out_btn" t-att-disabled="state.busy"
                        t-on-click.stop="() => this.moveCard(card.id, 'ready')" title="Pasar a Listo para cargar">
                    Listo <t t-call="sale_delivery_wizard.icon_arrow"/>
                </button>
                <button t-elif="stageKey === 'ready'" class="o_out_btn" t-att-disabled="state.busy"
                        t-on-click.stop="() => this.moveCard(card.id, 'in_route')" title="Generar la remisión y salir a ruta">
                    Remisión <t t-call="sale_delivery_wizard.icon_arrow"/>
                </button>
                <button t-elif="stageKey === 'in_route' and data.can_deliver_manual" class="o_out_btn" t-att-disabled="state.busy"
                        t-on-click.stop="() => this.moveCard(card.id, 'delivered')" title="Marcar como entregada (manual, queda rastro)">
                    Entregada <t t-call="sale_delivery_wizard.icon_check"/>
                </button>
            </div>
        </div>
    </t>

    <!-- ═══ Carril (etapa) ═══ -->
    <t t-name="sale_delivery_wizard.OutboundLane">
        <div t-attf-class="o_out_col {{ state.over === stage.key ? 'over' : '' }} {{ state.drag and this.canMove(state.drag.from, stage.key) ? 'target' : '' }}"
             t-on-dragover="(ev) => this.onLaneDragOver(ev, stage.key)"
             t-on-dragleave="(ev) => this.onLaneDragLeave(ev, stage.key)"
             t-on-drop="(ev) => this.onLaneDrop(ev, stage.key)">
            <div t-attf-class="o_out_col_head {{ stage.tone }}">
                <span class="step" t-esc="stage.step"/>
                <t t-call="sale_delivery_wizard.icon_stage"><t t-set="icon" t-value="stage.icon"/></t>
                <span class="lbl">
                    <span class="name" t-esc="stage.label"/>
                    <span class="hint" t-esc="stage.hint"/>
                </span>
                <span class="m2" t-if="this.stageM2(stage.key)"><t t-esc="this.stageM2(stage.key)"/> m²</span>
                <b t-esc="(data[stage.key] || []).length"/>
            </div>
            <div class="o_out_col_body">
                <t t-foreach="this.cards(stage.key)" t-as="card" t-key="card.id">
                    <t t-call="sale_delivery_wizard.OutboundCard"><t t-set="stageKey" t-value="stage.key"/></t>
                </t>
                <div t-if="!this.cards(stage.key).length" class="o_out_empty">
                    <t t-if="(data[stage.key] || []).length">Nada coincide con el filtro.</t>
                    <t t-elif="stage.key === 'pending'">Sin pick tickets por preparar.</t>
                    <t t-elif="stage.key === 'ready'">Nada listo para cargar.</t>
                    <t t-elif="stage.key === 'in_route'">Sin remisiones en ruta.</t>
                    <t t-else="">Aún sin entregas firmadas.</t>
                </div>
                <div t-if="state.drag and this.canMove(state.drag.from, stage.key)" class="o_out_dropzone">
                    Suelta aquí para pasar a <b t-esc="stage.label"/>
                </div>
            </div>
        </div>
    </t>

    <!-- ═══ Tablero ═══ -->
    <t t-name="sale_delivery_wizard.OutboundDashboard">
        <div class="o_outbound_dash">

            <!-- Barra superior: título, búsqueda, filtros, accesos -->
            <div class="o_out_topbar">
                <div class="o_out_title">
                    <div class="t">Salidas</div>
                    <div class="s" t-if="state.data">
                        <t t-esc="data.today_label"/>
                        · <b t-esc="data.kpis.pts_open"/> por surtir
                        · <b t-esc="data.kpis.in_route"/> en ruta
                        · <b t-esc="data.kpis.delivered"/> entregadas
                        <t t-if="data.kpis.delivered_m2"> (<t t-esc="data.kpis.delivered_m2"/> m²)</t>
                    </div>
                </div>
                <div class="o_out_search">
                    <t t-call="sale_delivery_wizard.icon_search"/>
                    <input type="text" placeholder="Folio, cliente, orden, camión, material…" t-att-value="state.search" t-on-input="onSearch"/>
                </div>
                <div class="o_out_chips" t-if="state.data">
                    <button t-attf-class="o_out_chip red {{ state.filter === 'noveh' ? 'on' : '' }}" t-on-click="() => this.setFilter('noveh')" title="Documentos por surtir sin camión asignado">
                        <t t-call="sale_delivery_wizard.icon_alert2"/> Sin camión <b t-esc="noVehicleCount"/>
                    </button>
                    <button t-attf-class="o_out_chip amber {{ state.filter === 'auth' ? 'on' : '' }}" t-on-click="() => this.setFilter('auth')" title="Órdenes que aún requieren autorización de entrega">
                        Por autorizar <b t-esc="pendingAuthCount"/>
                    </button>
                    <button t-attf-class="o_out_chip {{ state.filter === 'today' ? 'on' : '' }}" t-on-click="() => this.setFilter('today')" title="Pick tickets creados hoy">
                        Hoy <b t-esc="todayCount"/>
                    </button>
                </div>
                <div class="o_out_topbtns">
                    <button class="o_out_btn ghost" t-on-click="openPtList" title="Lista de pick tickets">Pick tickets</button>
                    <button class="o_out_btn ghost" t-on-click="openRemissionList" title="Lista de remisiones">Remisiones</button>
                    <button class="o_out_btn ghost" t-on-click="openLiveMap" title="Mapa en vivo"><t t-call="sale_delivery_wizard.icon_map"/> Mapa</button>
                    <button class="o_out_btn icon" t-on-click="refresh" title="Actualizar">
                        <t t-call="sale_delivery_wizard.icon_refresh"/>
                    </button>
                </div>
            </div>

            <div t-if="state.loading and !state.data" class="o_out_loading">Cargando el tablero…</div>

            <div t-if="state.data" class="o_out_body">
                <!-- Flujo del día: carriles secuenciales (la columna A taller se cuelga al final vía extensión).
                     El camión se asigna desde la orden de venta al generar la entrega, no aquí. -->
                <div class="o_out_cols">
                    <t t-foreach="stages" t-as="stage" t-key="stage.key">
                        <t t-call="sale_delivery_wizard.OutboundLane"/>
                    </t>
                </div>

            </div>
        </div>
    </t>

</templates>
