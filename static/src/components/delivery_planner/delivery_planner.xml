<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ═══ Tarjeta (semana y día) ═══ -->
    <t t-name="sale_delivery_wizard.PlannerCard">
        <div t-attf-class="o_dp_card st-{{ card.state }} {{ card.readiness ? 'has-issues' : '' }} {{ state.drag and state.drag.id === card.id ? 'dragging' : '' }} {{ this.isExpanded(card) ? 'open' : '' }}"
             t-att-draggable="this.isOpen(card) ? 'true' : 'false'"
             t-on-dragstart="(ev) => this.onDragStart(ev, card, dayIso)"
             t-on-dragend="onDragEnd"
             t-on-click="() => this.toggleExpand(card)">
            <div class="o_dp_card_top">
                <span class="time" t-esc="card.time_label"/>
                <span class="order" t-esc="card.order"/>
                <span t-attf-class="o_dp_state st-{{ card.state }}" t-esc="card.state_label"/>
            </div>
            <div class="o_dp_partner" t-esc="card.partner"/>
            <div class="o_dp_line"><span class="lbl">Vend.</span> <t t-esc="card.seller"/></div>
            <div class="o_dp_line qty" t-esc="card.qty"/>
            <div t-if="card.readiness" class="o_dp_issues" t-att-title="card.readiness">
                <i class="fa fa-exclamation-triangle" title=""/> <t t-esc="card.readiness"/>
            </div>
            <div t-if="card.reschedules" class="o_dp_moved" t-att-title="card.last_move">
                <i class="fa fa-history" title=""/> reprogramada <t t-esc="card.reschedules"/> vez<t t-if="card.reschedules !== 1">es</t>
                <span t-if="card.last_move" class="muted"> · <t t-esc="card.last_move"/></span>
            </div>
            <div t-if="card.vehicle" class="o_dp_line"><i class="fa fa-truck" title=""/> <t t-esc="card.vehicle"/><t t-if="card.driver"> · <t t-esc="card.driver"/></t></div>

            <div t-if="this.isExpanded(card)" class="o_dp_detail" t-on-click.stop="() => {}">
                <div class="o_dp_line"><span class="lbl">Contacto</span> <t t-esc="card.contact"/> · <a t-att-href="'tel:' + card.phone" t-esc="card.phone"/></div>
                <div class="o_dp_line addr"><span class="lbl">Dirección</span> <t t-esc="card.address"/></div>
                <div class="o_dp_spec" t-esc="card.instructions"/>
                <div t-if="card.pt or card.rem" class="o_dp_line"><span class="lbl">Docs</span> <t t-if="card.pt"><t t-esc="card.pt"/></t><t t-if="card.rem"> · <t t-esc="card.rem"/></t><t t-if="card.delivered_at"> · entregada <t t-esc="card.delivered_at"/></t></div>
                <div class="o_dp_actions">
                    <button class="o_dp_btn ghost" t-on-click.stop="() => this.openSchedule(card)">Abrir</button>
                    <button class="o_dp_btn ghost" t-on-click.stop="() => this.openOrder(card)">Orden</button>
                    <button t-if="card.has_location" class="o_dp_btn ghost" t-on-click.stop="() => this.openMap(card)"><i class="fa fa-map-marker" title=""/> Mapa</button>
                    <span class="grow"/>
                    <button t-if="data.is_staff and card.state === 'scheduled'" class="o_dp_btn" t-att-disabled="state.busy" t-on-click.stop="() => this.confirmCard(card)">Confirmar</button>
                    <button t-if="data.can_generate and this.isOpen(card)" class="o_dp_btn" t-att-disabled="state.busy" t-on-click.stop="() => this.generateDelivery(card)">Generar entrega</button>
                </div>
            </div>
        </div>
    </t>

    <!-- ═══ Ficha compacta (mes) ═══ -->
    <t t-name="sale_delivery_wizard.PlannerChip">
        <div t-attf-class="o_dp_chip_card st-{{ card.state }} {{ card.readiness ? 'has-issues' : '' }} {{ state.drag and state.drag.id === card.id ? 'dragging' : '' }}"
             t-att-draggable="this.isOpen(card) ? 'true' : 'false'"
             t-on-dragstart="(ev) => this.onDragStart(ev, card, dayIso)"
             t-on-dragend="onDragEnd"
             t-on-click.stop="() => this.openSchedule(card)"
             t-att-title="card.order + ' · ' + card.partner + ' · ' + card.time_label + (card.readiness ? ' · ' + card.readiness : '')">
            <span class="dot"/>
            <span class="o" t-esc="card.order"/>
            <span class="p" t-esc="card.partner"/>
            <i t-if="card.readiness" class="fa fa-exclamation-triangle" title=""/>
        </div>
    </t>

    <!-- ═══ Columna de día (semana) ═══ -->
    <t t-name="sale_delivery_wizard.PlannerDayColumn">
        <div t-attf-class="o_dp_day {{ day.is_today ? 'today' : '' }} {{ day.is_past ? 'past' : '' }} {{ day.weekday >= 5 ? 'weekend' : '' }} {{ state.over === day.iso ? 'over' : '' }} {{ state.drag and state.drag.from !== day.iso ? 'target' : '' }}"
             t-on-dragover="(ev) => this.onDayDragOver(ev, day.iso)"
             t-on-dragleave="(ev) => this.onDayDragLeave(ev, day.iso)"
             t-on-drop="(ev) => this.onDayDrop(ev, day.iso)">
            <div class="o_dp_day_head">
                <button class="d" t-on-click="() => this.openDay(day.iso)" title="Abrir el día"><t t-esc="day.label"/></button>
                <span class="n" t-if="day.open_count"><t t-esc="day.open_count"/> por entregar</span>
                <span class="n done" t-if="day.done_count"><t t-esc="day.done_count"/> ok</span>
                <span class="n warn" t-if="day.issues"><t t-esc="day.issues"/> pend.</span>
            </div>
            <div class="o_dp_day_body">
                <t t-foreach="this.cardsOf(day)" t-as="card" t-key="card.id">
                    <t t-call="sale_delivery_wizard.PlannerCard"><t t-set="dayIso" t-value="day.iso"/></t>
                </t>
                <div t-if="!this.cardsOf(day).length" class="o_dp_empty">—</div>
                <div t-if="state.drag and state.drag.from !== day.iso" class="o_dp_dropzone">Soltar aquí</div>
            </div>
        </div>
    </t>

    <!-- ═══ Tablero ═══ -->
    <t t-name="sale_delivery_wizard.DeliveryPlanner">
        <div t-attf-class="o_delivery_planner mode-{{ state.mode }}">
            <div class="o_dp_topbar">
                <div class="o_dp_title">
                    <div class="t"><t t-if="onlyMine">Mis entregas</t><t t-else="">Planificación de entregas</t></div>
                    <div class="s" t-if="state.data">
                        <b t-esc="totals.open"/> por entregar · <b t-esc="totals.done"/> entregadas
                        <span t-if="totals.issues" class="warn"> · <b t-esc="totals.issues"/> con pendientes</span>
                    </div>
                </div>
                <div class="o_dp_modes">
                    <button t-attf-class="o_dp_mode {{ state.mode === 'day' ? 'on' : '' }}" t-on-click="() => this.setMode('day')">Día</button>
                    <button t-attf-class="o_dp_mode {{ state.mode === 'week' ? 'on' : '' }}" t-on-click="() => this.setMode('week')">Semana</button>
                    <button t-attf-class="o_dp_mode {{ state.mode === 'month' ? 'on' : '' }}" t-on-click="() => this.setMode('month')">Mes</button>
                </div>
                <div class="o_dp_nav">
                    <button class="o_dp_btn ghost" t-on-click="() => this.shift(-1)" title="Anterior"><i class="fa fa-chevron-left" title=""/></button>
                    <button class="o_dp_btn ghost" t-on-click="goToday">Hoy</button>
                    <button class="o_dp_btn ghost" t-on-click="() => this.shift(1)" title="Siguiente"><i class="fa fa-chevron-right" title=""/></button>
                    <span class="o_dp_week" t-esc="title"/>
                </div>
                <div class="o_dp_search">
                    <i class="fa fa-search" title=""/>
                    <input type="text" placeholder="Orden, cliente, vendedor, dirección…" t-att-value="state.search" t-on-input="onSearch"/>
                </div>
                <div class="o_dp_tools">
                    <button t-attf-class="o_dp_chip {{ state.onlyIssues ? 'on' : '' }}" t-on-click="toggleIssues" title="Solo entregas con información o autorización pendiente">
                        <i class="fa fa-exclamation-triangle" title=""/> Con pendientes
                    </button>
                    <button t-if="data.overdue" class="o_dp_chip red" t-on-click="openOverdue" title="Programadas en días pasados y no entregadas">
                        <i class="fa fa-clock-o" title=""/> Atrasadas <b t-esc="data.overdue"/>
                    </button>
                </div>
            </div>

            <div t-if="state.loading and !state.data" class="o_dp_loading">Cargando…</div>

            <!-- ═══ DÍA ═══ -->
            <div t-if="state.data and state.mode === 'day'" class="o_dp_dayview"
                 t-on-dragover="(ev) => this.onDayDragOver(ev, day.iso)"
                 t-on-drop="(ev) => this.onDayDrop(ev, day.iso)">
                <div class="o_dp_day_strip">
                    <t t-foreach="[-3, -2, -1, 0, 1, 2, 3]" t-as="off" t-key="off">
                        <button t-attf-class="o_dp_strip_day {{ off === 0 ? 'on' : '' }} {{ state.over === this.dayOffset(off) ? 'over' : '' }}"
                                t-on-click="() => this.openDay(this.dayOffset(off))"
                                t-on-dragover="(ev) => this.onDayDragOver(ev, this.dayOffset(off))"
                                t-on-dragleave="(ev) => this.onDayDragLeave(ev, this.dayOffset(off))"
                                t-on-drop="(ev) => this.onDayDrop(ev, this.dayOffset(off))"
                                t-att-title="off === 0 ? '' : 'Ver este día (o soltar aquí para reprogramar)'">
                            <span class="w" t-esc="this.dayShort(this.dayOffset(off))"/>
                            <span class="n" t-esc="this.dayNumber(this.dayOffset(off))"/>
                        </button>
                    </t>
                </div>
                <div t-if="!daySections.length" class="o_dp_empty big">
                    <t t-if="day.cards.length">Nada coincide con el filtro.</t>
                    <t t-else="">Sin entregas programadas para este día.</t>
                </div>
                <t t-foreach="daySections" t-as="sec" t-key="sec.key">
                    <div class="o_dp_section">
                        <div class="o_dp_section_head"><span t-esc="sec.label"/><b t-esc="sec.cards.length"/></div>
                        <div class="o_dp_section_grid">
                            <t t-foreach="sec.cards" t-as="card" t-key="card.id">
                                <t t-call="sale_delivery_wizard.PlannerCard"><t t-set="dayIso" t-value="day.iso"/></t>
                            </t>
                        </div>
                    </div>
                </t>
            </div>

            <!-- ═══ SEMANA ═══ -->
            <div t-if="state.data and state.mode === 'week'" class="o_dp_week_grid">
                <t t-foreach="days" t-as="day" t-key="day.iso">
                    <t t-call="sale_delivery_wizard.PlannerDayColumn"/>
                </t>
            </div>

            <!-- ═══ MES ═══ -->
            <div t-if="state.data and state.mode === 'month'" class="o_dp_month">
                <div class="o_dp_month_head">
                    <t t-foreach="daysShort" t-as="dn" t-key="dn"><div class="h" t-esc="dn"/></t>
                </div>
                <div class="o_dp_month_grid">
                    <t t-foreach="days" t-as="day" t-key="day.iso">
                        <div t-attf-class="o_dp_cell {{ day.month !== anchorMonth ? 'out' : '' }} {{ day.is_today ? 'today' : '' }} {{ day.is_past ? 'past' : '' }} {{ day.weekday >= 5 ? 'weekend' : '' }} {{ state.over === day.iso ? 'over' : '' }} {{ state.drag and state.drag.from !== day.iso ? 'target' : '' }}"
                             t-on-dragover="(ev) => this.onDayDragOver(ev, day.iso)"
                             t-on-dragleave="(ev) => this.onDayDragLeave(ev, day.iso)"
                             t-on-drop="(ev) => this.onDayDrop(ev, day.iso)"
                             t-on-click="() => this.openDay(day.iso)">
                            <div class="o_dp_cell_head">
                                <span class="n" t-esc="day.day"/>
                                <span class="c" t-if="day.open_count" t-esc="day.open_count"/>
                                <span class="c done" t-if="day.done_count" t-esc="day.done_count"/>
                            </div>
                            <div class="o_dp_cell_body">
                                <t t-foreach="this.cardsOf(day).slice(0, 4)" t-as="card" t-key="card.id">
                                    <t t-call="sale_delivery_wizard.PlannerChip"><t t-set="dayIso" t-value="day.iso"/></t>
                                </t>
                                <div t-if="this.cardsOf(day).length > 4" class="o_dp_more">+<t t-esc="this.cardsOf(day).length - 4"/> más</div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Diálogo de motivo al reprogramar por arrastre -->
            <div t-if="state.move" class="o_dp_modal_bg" t-on-click="cancelMove">
                <div class="o_dp_modal" t-on-click.stop="() => {}">
                    <div class="h">Reprogramar <b t-esc="state.move.order"/></div>
                    <div class="p">Del <b t-esc="this.fmtIso(state.move.from)"/> al <b t-esc="this.fmtIso(state.move.to)"/>. El vendedor recibirá el aviso con este motivo y quedará en el historial.</div>
                    <textarea rows="3" placeholder="Motivo (obligatorio)" t-att-value="state.move.reason" t-on-input="onMoveReason"/>
                    <div class="f">
                        <button class="o_dp_btn ghost" t-on-click="cancelMove">Cancelar</button>
                        <button class="o_dp_btn" t-att-disabled="state.busy" t-on-click="confirmMove">Reprogramar</button>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
